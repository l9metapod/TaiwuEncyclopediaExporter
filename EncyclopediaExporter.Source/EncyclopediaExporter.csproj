<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>EncyclopediaExporter</AssemblyName>
    <RootNamespace>EncyclopediaExporter</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyTitle>EncyclopediaExporter</AssemblyTitle>
    <Version>1.0.0.0</Version>
    <Configuration>Release</Configuration>
    <OutputType>Library</OutputType>
    <!-- 不生成 pdb（mod 加载虽支持 pdb，但简化分发） -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    GameDir: 游戏根目录。本仓库通过本地的 Game junction（目录联接）指向 Steam 游戏目录，
    便于在仓库内直接查看游戏资源与反编译代码、以及引用游戏程序集。
    建 junction：mklink /J Game "D:\...\The Scroll Of Taiwu"
    （Game 已在 .gitignore 中排除，不会提交。）
    若游戏装在别处且不想用 junction，可改用: msbuild -p:GameDir="D:\path\to\The Scroll Of Taiwu"
  -->
  <PropertyGroup>
    <GameDir>$(MSBuildThisFileDirectory)..\Game\</GameDir>
    <ManagedDir>$(GameDir)The Scroll of Taiwu_Data\Managed\</ManagedDir>
    <ModOutputDir>$(GameDir)Mod\EncyclopediaExporter\Plugins\</ModOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- mod 插件必需引用 -->
    <Reference Include="TaiwuModdingLib">
      <HintPath>$(ManagedDir)TaiwuModdingLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity 引擎（Initialize 里用到 Application/Debug） -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToModAfterBuild" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(ModOutputDir)"
          Condition="Exists('$(ModOutputDir)') OR !Exists('$(ModOutputDir)')" />
    <Message Text="已复制 $(AssemblyName).dll 到 $(ModOutputDir)" Importance="high" />
  </Target>

</Project>
